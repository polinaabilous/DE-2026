rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      // This personal tracker is restricted to its owner’s verified Google account.
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'polinaa.bilous@gmail.com';
    }
    match /users/{uid}/records/{record} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && record.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['key', 'value', 'mutation'])
        && request.resource.data.keys().hasAll(['key', 'value', 'mutation'])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 4000
        && (request.resource.data.value == null ||
          (request.resource.data.value is string && request.resource.data.value.size() <= 500000))
        && request.resource.data.mutation is string
        && request.resource.data.mutation.size() > 0
        && request.resource.data.mutation.size() <= 100;
      // Deletions use tombstones, so an offline device cannot resurrect a removed entry.
      allow delete: if false;
    }
  }
}
