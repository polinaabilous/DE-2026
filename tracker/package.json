{
  "name": "ae-roadmap-tracker",
  "private": true,
  "scripts": {
    "build:search": "node scripts/build-deck-search.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-ae-tracker --only firestore \"node --test tests/firestore-rules.cjs\"",
    "deploy": "firebase deploy --only firestore,hosting",
    "backup": "node scripts/backup-folder.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "test:search": "node tests/run-search-browser.mjs",
    "test:sync": "firebase emulators:exec --project demo-ae-tracker --only auth,firestore \"node tests/run-cloud-browser.mjs\"",
    "build:architecture": "node scripts/build-architecture-deck.cjs",
    "test:architecture": "node tests/run-architecture-browser.mjs",
    "test:history": "node tests/run-deck-history-browser.mjs",
    "build:scd": "node scripts/build-dimension-scd.cjs",
    "test:scd": "node tests/run-scd-browser.mjs",
    "build:map": "node scripts/build-data-landscape.cjs",
    "test:map": "node tests/run-data-map-browser.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
