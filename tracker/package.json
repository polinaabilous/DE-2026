{
  "name": "ae-roadmap-tracker",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-ae-tracker --only firestore \"node --test tests/firestore-rules.cjs\"",
    "deploy": "firebase deploy --only firestore,hosting",
    "backup": "node scripts/backup-folder.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "test:sync": "firebase emulators:exec --project demo-ae-tracker --only auth,firestore \"node tests/run-cloud-browser.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
